        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="jdbc.resultsettable" level="OFF" additive="false" >
        <appender-ref ref="CONSOLE"/>
    </logger> -->


    <!-- 로그 전역 세팅 -->
    <root level="${LOG_LEVEL}">
        <!-- 위에 설정한 콘솔 설정 추가 -->
        <appender-ref ref="CONSOLE"/>
        <!-- 위에 설정한 파일 설정 추가 -->
<!--        <appender-ref ref="FILE"/> -->
    </root>
</configuration>